DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qadocs?schema=public"
AUTH_SECRET="replace_me_with_long_random_string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# Публичный URL приложения для ссылок в задачах Jira (без слэша в конце). Опционально в dev.
# NEXT_PUBLIC_APP_URL="https://qa-docs.example.com"

# Jira Cloud (REST API): email + API token, базовый URL сайта.
# JIRA_BASE_URL="https://your-site.atlassian.net"
# JIRA_EMAIL="you@example.com"
# JIRA_API_TOKEN=""

# Ключ Jira-проекта по умолчанию (если не задан в карточке проекта qa-docs).
# JIRA_PROJECT_KEY="SCRUM"

# Тип задачи: имя (Task, Story и т.д.) или надёжнее — id типа из Jira.
# JIRA_ISSUE_TYPE="Task"
# JIRA_ISSUE_TYPE_ID="10001"
