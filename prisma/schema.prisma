// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  editor
  viewer
}

enum ArtifactStatus {
  draft
  active
  archived
}

enum RunStatus {
  pending
  running
  passed
  failed
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(viewer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  disabledAt   DateTime?
  deletedAt    DateTime?

  projectAccesses UserProjectAccess[]
  startedRuns Run[] @relation("RunStarter")
  cancelledRuns Run[] @relation("RunCanceller")
  updatedSteps StepRunResult[]
  runComments StepRunComment[]
  runAttachments RunAttachment[]
  runOverrides RunOverrideEvent[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testCases  TestCase[]
  checklists Checklist[]
  testPlans  TestPlan[]
  userAccesses UserProjectAccess[]
  engineRuns Run[]
}

model UserProjectAccess {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model TestCase {
  id            String         @id @default(cuid())
  projectId     String
  title         String
  description   String         @default("")
  preconditions  String         @default("")
  postconditions String         @default("")
  expected       String         @default("")
  status        ArtifactStatus @default(draft)
  tags          String[]       @default([])
  stepsJson     Json           @default("[]")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plans   TestPlanCase[]
  runs    TestCaseRun[]
  engineRuns Run[]
  enginePlanItems TestPlanRunItem[]

  @@index([projectId])
  @@index([status])
  @@index([title])
}

model Checklist {
  id        String         @id @default(cuid())
  projectId String
  title     String
  itemsJson Json           @default("[]")
  status    ArtifactStatus @default(draft)
  tags      String[]       @default([])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plans   TestPlanChecklist[]
  runs    ChecklistRun[]
  engineRuns Run[]
  enginePlanItems TestPlanRunItem[]

  @@index([projectId])
  @@index([status])
  @@index([title])
}

model TestPlan {
  id        String         @id @default(cuid())
  projectId String
  title     String
  objective String         @default("")
  scope     String         @default("")
  status    ArtifactStatus @default(draft)
  tags      String[]       @default([])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   TestPlanCase[]
  checklists TestPlanChecklist[]
  runs    TestPlanRun[]
  engineRuns Run[]

  @@index([projectId])
  @@index([status])
  @@index([title])
}

model TestPlanChecklist {
  testPlanId String
  checklistId String
  order      Int    @default(0)

  testPlan TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@id([testPlanId, checklistId])
  @@index([checklistId])
}

model TestPlanCase {
  testPlanId String
  testCaseId String
  order      Int    @default(0)

  testPlan TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@id([testPlanId, testCaseId])
  @@index([testCaseId])
}

model TestCaseRun {
  id           String     @id @default(cuid())
  testCaseId   String
  status       RunStatus  @default(pending)
  actualResult String     @default("")
  notes        String     @default("")
  stepsJson    Json       @default("[]")
  attachmentsJson Json     @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Restrict)

  @@index([testCaseId])
  @@index([status])
  @@index([createdAt])
}

model ChecklistRun {
  id           String     @id @default(cuid())
  checklistId  String
  status       RunStatus  @default(pending)
  itemResults  Json       @default("[]")
  notes        String     @default("")
  attachmentsJson Json     @default("[]")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Restrict)

  @@index([checklistId])
  @@index([status])
  @@index([createdAt])
}

model TestPlanRun {
  id          String     @id @default(cuid())
  testPlanId  String
  status      RunStatus  @default(pending)
  summary     String     @default("")
  detailsJson Json       @default("[]")
  attachmentsJson Json     @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  testPlan TestPlan @relation(fields: [testPlanId], references: [id], onDelete: Restrict)

  @@index([testPlanId])
  @@index([status])
  @@index([createdAt])
}

enum RunKind {
  test_case
  checklist
  test_plan
}

enum RunLifecycle {
  in_progress
  completed
  cancelled
}

enum ResultStatus {
  passed
  failed
  questionable
}

enum Severity {
  low
  medium
  high
  critical
}

// Immutable by database trigger. Numbered document versions belong to Phase B.
model RunDefinitionSnapshot {
  id String @id @default(cuid())
  schemaVersion Int @default(1)
  definition Json
  contentHash String
  createdAt DateTime @default(now())
  run Run?
  planItem TestPlanRunItem?
}

model Run {
  id String @id @default(cuid())
  projectId String
  kind RunKind
  testCaseId String?
  checklistId String?
  testPlanId String?
  snapshotId String @unique
  lifecycle RunLifecycle @default(in_progress)
  autoStatus ResultStatus?
  finalStatus ResultStatus?
  startedAt DateTime @default(now())
  startedById String
  startedByEmailSnapshot String
  startedByDisplayNameSnapshot String?
  completedAt DateTime?
  cancelledAt DateTime?
  cancelledById String?
  cancelledByEmailSnapshot String?
  cancelledByDisplayNameSnapshot String?
  cancelReason String?
  durationMs BigInt?
  revision Int @default(0)
  idempotencyKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  testCase TestCase? @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  checklist Checklist? @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  testPlan TestPlan? @relation(fields: [testPlanId], references: [id], onDelete: Restrict)
  snapshot RunDefinitionSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  startedBy User @relation("RunStarter", fields: [startedById], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("RunCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  steps StepRunResult[]
  attachments RunAttachment[]
  overrides RunOverrideEvent[]
  planItems TestPlanRunItem[] @relation("PlanRun")
  planItem TestPlanRunItem? @relation("ChildRun")

  @@unique([startedById, idempotencyKey])
  @@index([projectId, lifecycle])
  @@index([testCaseId, startedAt, id])
  @@index([checklistId, startedAt, id])
  @@index([testPlanId, startedAt, id])
}

model StepRunResult {
  id String @id @default(cuid())
  runId String
  occurrenceKey String
  result ResultStatus?
  severity Severity?
  actualResult String @default("")
  updatedById String?
  updatedByEmailSnapshot String?
  updatedByDisplayNameSnapshot String?
  updatedAt DateTime @updatedAt
  revision Int @default(0)
  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  comments StepRunComment[]
  attachments RunAttachment[]
  @@unique([runId, occurrenceKey])
  @@unique([id, runId])
  @@index([runId, result])
}

model StepRunComment {
  id String @id @default(cuid())
  stepRunResultId String
  authorId String
  authorEmailSnapshot String
  authorDisplayNameSnapshot String?
  body String
  createdAt DateTime @default(now())
  stepRunResult StepRunResult @relation(fields: [stepRunResultId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([stepRunResultId, createdAt])
}

model RunAttachment {
  id String @id @default(cuid())
  runId String
  stepRunResultId String?
  pathname String @unique
  originalName String
  contentType String
  size Int
  uploadedById String
  uploadedByEmailSnapshot String
  uploadedByDisplayNameSnapshot String?
  createdAt DateTime @default(now())
  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)
  stepRunResult StepRunResult? @relation(fields: [stepRunResultId, runId], references: [id, runId], onDelete: Restrict)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  @@index([runId])
  @@index([stepRunResultId])
}

model RunOverrideEvent {
  id String @id @default(cuid())
  runId String
  autoStatus ResultStatus
  previousFinalStatus ResultStatus
  finalStatus ResultStatus
  reason String
  overriddenById String
  overriddenByEmailSnapshot String
  overriddenByDisplayNameSnapshot String?
  overriddenAt DateTime @default(now())
  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)
  overriddenBy User @relation(fields: [overriddenById], references: [id], onDelete: Restrict)
  @@index([runId, overriddenAt])
}

model TestPlanRunItem {
  id String @id @default(cuid())
  planRunId String
  position Int
  testCaseId String?
  checklistId String?
  snapshotId String @unique
  childRunId String? @unique
  cancelledAt DateTime?
  planRun Run @relation("PlanRun", fields: [planRunId], references: [id], onDelete: Restrict)
  childRun Run? @relation("ChildRun", fields: [childRunId], references: [id], onDelete: Restrict)
  snapshot RunDefinitionSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  testCase TestCase? @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  checklist Checklist? @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  @@unique([planRunId, position])
}
